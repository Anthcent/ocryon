# Copia este archivo a .env y ajusta los valores.

# Puerto y dirección del servidor (API + frontend compilado en producción).
# En Docker ya vienen fijados: PORT=8080 y HOST=0.0.0.0.
PORT=3001
# HOST=0.0.0.0

# Obligatorios en producción (mínimo 16 caracteres, genéralos con: openssl rand -hex 32)
JWT_SECRET=
ENCRYPTION_KEY=

# Base de datos PostgreSQL. En Hexper Ops se inyecta sola al elegir «PostgreSQL automático».
# Si no se define, se usa PGlite (PostgreSQL embebido, sin instalar nada) guardado en DATA_DIR.
# DATABASE_URL=postgres://usuario:contraseña@servidor:5432/ocryon
# DATA_DIR=apps/server/data/pglite

# Claves globales opcionales. Cada usuario puede poner las suyas en Ajustes;
# si no lo hace, se usan estas.
# OCRSPACE_API_KEY=
# GEMINI_API_KEY=
