# Copia este archivo a .env y ajusta los valores.

# Puerto del servidor (API + frontend compilado en producción)
PORT=3001

# Obligatorios en producción (mínimo 16 caracteres, genéralos con: openssl rand -hex 32)
JWT_SECRET=
ENCRYPTION_KEY=

# Ruta de la base de datos SQLite (por defecto apps/server/data/ocryon.db)
# DATABASE_PATH=

# Claves globales opcionales. Cada usuario puede poner las suyas en Ajustes;
# si no lo hace, se usan estas.
# OCRSPACE_API_KEY=
# GEMINI_API_KEY=
